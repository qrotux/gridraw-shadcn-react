{
  "name": "synthetic",
  "idColumn": "id",
  "pageSize": 20,
  "pageSizeOptions": [10, 20, 50, 100],
  "defaultSort": { "column": "name", "dir": "asc" },
  "search": { "columns": ["name"] },
  "columns": [
    {
      "key": "name",
      "type": "string",
      "title": "Name",
      "sortable": true,
      "defaultVisible": true,
      "filter": {
        "operators": [{ "op": "contains", "label": "contains" }]
      }
    },
    {
      "key": "status",
      "type": "enum",
      "title": "Status",
      "sortable": true,
      "defaultVisible": true,
      "filter": {
        "operators": [{ "op": "eq", "label": "=" }],
        "enumValues": [
          { "value": "active", "label": "Active" },
          { "value": "inactive", "label": "Inactive" }
        ]
      }
    },
    {
      "key": "createdAt",
      "type": "datetime",
      "title": "Created",
      "sortable": true,
      "defaultVisible": true
    }
  ]
}
